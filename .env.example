# Copy to .env on each machine and fill in. Never commit .env.
# Values come from the Solution Provider Portal (SP-API), the WooCommerce
# REST API key (Read-only) and Flipkart Seller Hub (Developer Access > Self Access).

SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN_VENDOR=
SPAPI_REFRESH_TOKEN_SELLER=

WOO_URL=https://b2b.axonlifestyle.com
WOO_KEY=
WOO_SECRET=

FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

# Mac (local passwordless login):   postgresql:///axon_amazon
# Windows (password login):         postgresql://postgres:PASSWORD@localhost:5432/axon_amazon
DATABASE_URL=postgresql:///axon_amazon

# Read-only login for the Claude Desktop connection (mcp_server.py).
# Mac: leave commented out. Windows:
# MCP_DATABASE_URL=postgresql://mcp_reader:PASSWORD@localhost:5432/axon_amazon

# Optional - defaults are already correct
# AXON_SELLER_ID=A1QTZ8OBV6L6UD
# VENDOR_CHANNEL_SELLER_ID=A2AL6IVND0I91F
